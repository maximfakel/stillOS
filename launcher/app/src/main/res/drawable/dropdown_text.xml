<?xml version="1.0" encoding="utf-8"?>
<!-- Dropdown row text and icon: #F5F5F5 focused or selected, #A3A3A3 otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="#FFF5F5F5" />
    <item android:state_activated="true" android:color="#FFF5F5F5" />
    <item android:color="#FFA3A3A3" />
</selector>
