<?xml version="1.0" encoding="utf-8"?>
<!-- Dropdown row: 16.5dp Untitled UI icon, the label and an optional status.
     36dp tall like the header items; text and icon grey, white when focused or selected. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="36dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="8.25dp"
    android:paddingEnd="8.25dp"
    android:background="@drawable/dropdown_row_bg"
    android:focusable="true"
    android:clickable="true">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="16.5dp"
        android:layout_height="16.5dp"
        android:tint="@drawable/dropdown_text"
        android:duplicateParentState="true"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8.25dp"
        android:layout_marginEnd="8.25dp"
        android:textColor="@drawable/dropdown_text"
        android:duplicateParentState="true"
        android:textSize="13.5sp"
        android:fontFamily="@font/outfit_regular"
        android:includeFontPadding="false"
        android:singleLine="true" />

    <View
        android:id="@+id/dot"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginEnd="6dp"
        android:visibility="gone"
        android:background="@drawable/status_dot" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:textColor="#FF8A8A8A"
        android:textSize="11.25sp"
        android:fontFamily="@font/outfit_regular" />

</LinearLayout>
